# Compilação para o Android (`npm run build:android`, chamado pelo Tauri).
#
# O celular não roda o Django: o app conversa com o servidor na nuvem. Troque
# o endereço abaixo pelo do seu servidor antes de gerar o APK. Precisa ser
# HTTPS: o Android bloqueia HTTP puro por padrão, e o servidor precisa listar
# a origem do app em CORS_ALLOWED_ORIGINS (`https://tauri.localhost`).
VITE_API_URL=https://SEU-SERVIDOR.exemplo/api
