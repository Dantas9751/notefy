# Compilação para o aplicativo de desktop (`npm run build:desktop`).
#
# No navegador o Vite faz proxy de /api para o Django, então o frontend usa
# um caminho relativo. Dentro do Tauri não há proxy: a janela carrega de
# um protocolo próprio e precisa do endereço absoluto do backend embutido.
# A porta é a mesma gravada em backend/desktop_server.py.
VITE_API_URL=http://127.0.0.1:8756/api
