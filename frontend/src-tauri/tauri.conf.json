{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Notefy",
  "version": "1.0.0",
  "identifier": "com.notefy.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Notefy",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Notefy",
    "shortDescription": "Notas, arquivos, planilhas, diagramas e planner",
    "longDescription": "Notefy — um Drive somado a um Notion: notas em texto rico, arquivos, planilhas, diagramas UML e canvas nas mesmas pastas, com calendário e quadro Kanban.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/notefy-server"],
    "resources": {
      "binaries/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"]
      }
    }
  }
}
