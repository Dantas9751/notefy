{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões das janelas do Notefy: o padrão do Tauri, o direito de executar o backend empacotado e o de destacar uma aba em janela própria.",
  "windows": ["main", "notefy-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/notefy-server",
          "sidecar": true,
          "args": false
        }
      ]
    }
  ]
}
