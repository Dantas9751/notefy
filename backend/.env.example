# Copie para `.env` e ajuste. O arquivo .env NÃO vai para o git.

# Gere a sua com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# Precisa ter 32+ caracteres: é a chave HMAC que assina os tokens JWT.
SECRET_KEY=troque-esta-chave-por-uma-gerada-com-o-comando-acima
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Origem do Vite em desenvolvimento
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
DB_NAME=notefy
DB_USER=banco
DB_PASSWORD=2701
DB_HOST=localhost
DB_PORT=5432

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=14

# Uploads
MAX_UPLOAD_SIZE_MB=50
